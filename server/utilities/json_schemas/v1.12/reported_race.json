{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/UCI-GREGoR/GREGor_dashboard/blob/main/server/utilities/v1.12/json_schemas/reported_race.json",
    "title": "reported_race",
    "version": "1.12",
    "type": "object",
