{
    "$id": "urn:gregor:data-model:1.12:aligned",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {},
    "properties": {
        "aligned_file": {
            "pattern": "^(https?|gs|s3):\\/\\/.+$",
            "type": "string",
            "x-is_bucket_path": true
        },
        "aligned_id": {
            "description": "table_name.aligned_id_in_table",
            "examples": [
                "aligned_dna_short_read.BCM_H7YG5DSX2-3-IDUDI0014-1"
            ],
            "type": "string",
            "x-primary-key": true
        },
        "aligned_index_file": {
            "pattern": "^(https?|gs|s3):\\/\\/.+$",
            "type": "string",
            "x-is_bucket_path": true
        },
        "id_in_table": {
            "examples": [
                "BCM_H7YG5DSX2-3-IDUDI0014-1"
            ],
            "type": "string"
        },
        "participant_id": {
            "examples": [
                "BCM_H7YG5DSX2"
            ],
            "type": "string",
            "x-references": "> participant.participant_id"
        },
        "table_name": {
            "enum": [
                "aligned_dna_short_read",
                "aligned_rna_short_read",
                "aligned_nanopore",
                "aligned_pac_bio",
                "aligned_atac_short_read",
                "aligned_molecules_optical_mapping",
                "aligned_iclr"
            ],
            "examples": [
                "aligned_dna_short_read"
            ],
            "type": "string"
        }
    },
    "required": [
        "aligned_id",
        "table_name",
        "id_in_table",
        "participant_id"
    ],
    "title": "aligned",
    "type": "object",
    "version": "1.12"
}
