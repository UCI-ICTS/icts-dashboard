{
    "$id": "urn:gregor:data-model:1.12:aligned_iclr",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {},
    "properties": {
        "aligned_iclr_file": {
            "description": "name and path of file with aligned reads",
            "examples": [
                "gs://fc-eb352699-d849-483f-aefe-9d35ce2b21ac/Broad_COL_FAM1_1_D1.cram"
            ],
            "pattern": "^(https?|gs|s3):\\/\\/.+$",
            "type": "string",
            "x-is_bucket_path": true
        },
        "aligned_iclr_id": {
            "description": "identifier for aligned_iclr (primary key)\n\nNotes: experiment_iclr_id + alignment indicator",
            "examples": [
                "BCM_H7YG5DSX2-3-IDUDI0014-1"
            ],
            "type": "string",
            "x-primary-key": true
        },
        "aligned_iclr_index_file": {
            "description": "name and path of index file corresponding to aligned reads file",
            "examples": [
                "gs://fc-eb352699-d849-483f-aefe-9d35ce2b21ac/Broad_COL_FAM1_1_D1.crai"
            ],
            "pattern": "^(https?|gs|s3):\\/\\/.+$",
            "type": "string",
            "x-is_bucket_path": true
        },
        "alignment_software": {
            "description": "Software including version number\n\nNotes: Can be unknown if RC receives external data",
            "examples": [
                "DRAGEN ICLR WGS 2.0.6"
            ],
            "type": "string"
        },
        "analysis_details": {
            "description": "brief description of the analysis pipeline used for producing the file; perhaps a DOI or link to something like a WDL file or github repository",
            "examples": [
                "DOI:10.5281/zenodo.4469317"
            ],
            "type": "string"
        },
        "experiment_iclr_id": {
            "description": "identifier for experiment",
            "type": "string",
            "x-references": "> experiment_iclr.experiment_iclr_id"
        },
        "md5sum": {
            "description": "md5 checksum for file",
            "examples": [
                "129c28163df082"
            ],
            "type": "string"
        },
        "mean_coverage": {
            "description": "For WGS, mean coverage is calculated as total aligned bases divided by length of the genome. For WES, mean coverage is calculated as total bases within capture regions divided by length of the capture regions. The capture regions are defined in the BED file for the sample (linked in the experiment_dna_iclr table targeted_region_bed_file field).\n\nNotes: Can be unknown if RC receives external data",
            "examples": [
                "100"
            ],
            "type": "number"
        },
        "quality_issues": {
            "description": "describe if there are any QC issues that would be important to note",
            "type": "string"
        },
        "reference_assembly": {
            "enum": [
                "GRCh38",
                "GRCh37",
                "NCBI36",
                "NCBI35",
                "NCBI34"
            ],
            "examples": [
                "GRCh38"
            ],
            "type": "string"
        },
        "reference_assembly_details": {
            "examples": [
                "primary, chrY-masked"
            ],
            "type": "string"
        },
        "reference_assembly_uri": {
            "examples": [
                "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_33/GRCh38.primary_assembly.genome.fa.gz"
            ],
            "type": "string"
        }
    },
    "required": [
        "aligned_iclr_id",
        "experiment_iclr_id",
        "aligned_iclr_file",
        "aligned_iclr_index_file",
        "md5sum",
        "reference_assembly",
        "alignment_software"
    ],
    "title": "aligned_iclr",
    "type": "object",
    "version": "1.12",
    "x-table-required": "CONDITIONAL (aligned_iclr_set, called_variants_iclr)"
}
